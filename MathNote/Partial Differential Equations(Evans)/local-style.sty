% 确保 exercise 环境的 cref 名称
\crefname{exercise}{习题}{习题}
\Crefname{exercise}{习题}{习题}

% examples 环境计数器为 examples
\crefname{examples}{例}{例}

% align 公式引用用 eqref，不需额外 cref 名称
% 三竖线范数（Evans 书中能量估计用）


% coloneqq 别名
\providecommand{\coloneqq}{\triangleq}

% 三竖线范数（避免 \left/\right 跨 align 行问题）
\providecommand{\lll}{\|\!\|}
\providecommand{\rrr}{\|\!\|}

% v10: cref name for exercise counter (exer)
\crefname{exer}{练习}{练习}
\Crefname{exer}{练习}{练习}

% v12: Appendix chapter cross-reference names
\crefname{appendix}{附录}{附录}
\Crefname{appendix}{附录}{附录}
